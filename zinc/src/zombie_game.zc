func absolute (value: int): int
	if value < 0
		return -value
	end
	return value
end

func random number (limit: int): int
	random state = random state * 1664525:d + 1013904223:d
	return ((random state >> 16) % limit):int
end

func say dialogue (id: int)
	if enhanced mode == 0 || dialogue enabled == 0 || dialogue time > 0
		return
	end
	dialogue id = id
	dialogue time = 2800
end

func say dialogue trio (first: int, second: int, third: int)
	def variation = random number (3)
	if variation == 0
		say dialogue (first)
	elsif variation == 1
		say dialogue (second)
	else
		say dialogue (third)
	end
end

func say dialogue quad (first: int, second: int, third: int, fourth: int)
	def variation = random number (4)
	if variation == 0
		say dialogue (first)
	elsif variation == 1
		say dialogue (second)
	elsif variation == 2
		say dialogue (third)
	else
		say dialogue (fourth)
	end
end

func say damage dialogue (kind: int)
	if enhanced mode == 0 || random number (3) <> 0
		return
	end
	if kind == 1
		say dialogue (129)
	elsif kind == 2 && random number (2) == 0
		say dialogue (130)
	else
		say dialogue (125 + random number (4))
	end
end

func choose ambient story: int
	def candidate = 0
	def attempts = 0
	if ambient story used == 4095:d
		ambient story used = 0:d
	end
	while attempts < 32
		candidate = random number (12)
		if candidate <> ambient story last &&
		   (ambient story used & (1:d << candidate)) == 0:d
			return candidate
		end
		++attempts
	end
	candidate = 0
	while candidate < 12
		if candidate <> ambient story last &&
		   (ambient story used & (1:d << candidate)) == 0:d
			return candidate
		end
		++candidate
	end
	return 0
end

func start ambient story
	def story = 0
	if enhanced mode == 0 || dialogue enabled == 0 || dialogue time > 0 || ambient story active <> 0 ||
	   ambient story cooldown > 0
		return
	end
	story = choose ambient story
	ambient story index = story
	ambient story last = story
	ambient story used |= (1:d << story)
	ambient story active = 1
	ambient story step = 1
	dialogue id = 87 + story * 3
	dialogue time = 2800
	// Keep the two ambient systems from speaking back-to-back.
	farm joke cooldown = 26000 + random number (18000)
	scenery comment cooldown = 22000 + random number (12000)
	director comment cooldown = 22000 + random number (12000)
	transition comment cooldown = 22000 + random number (12000)
	ambient story cooldown = 55000 + random number (35000)
end

func update dialogue (elapsed: int)
	if farm joke cooldown > 0
		farm joke cooldown -= elapsed
	end
	if ambient story cooldown > 0
		ambient story cooldown -= elapsed
	end
	if scenery comment cooldown > 0
		scenery comment cooldown -= elapsed
	end
	if director comment cooldown > 0
		director comment cooldown -= elapsed
	end
	if transition comment cooldown > 0
		transition comment cooldown -= elapsed
	end
	if yeti distraction cooldown > 0
		yeti distraction cooldown -= elapsed
	end
	if dialogue time > 0
		dialogue time -= elapsed
		if dialogue time <= 0
			dialogue time = 0
			dialogue id = 0
			if ambient story active <> 0
				if ambient story step < 3
					++ambient story step
					dialogue id = 87 + ambient story index * 3 + ambient story step - 1
					dialogue time = 2800
				else
					ambient story active = 0
					ambient story step = 0
				end
			elsif yeti distraction active <> 0
				if yeti distraction step < 3
					++yeti distraction step
					dialogue id = 186 + yeti distraction step - 1
					dialogue time = 2800
				else
					yeti distraction active = 0
					yeti distraction step = 0
				end
			end
		end
	elsif enhanced mode <> 0 && farm joke cooldown <= 0
		if wolf event seen <> 0 && random number (4) == 0
			say dialogue (78 + random number (6))
		else
			say dialogue (70 + random number (8))
		end
		farm joke cooldown = 24000 + random number (18000)
		if director comment cooldown <= 0
			director comment cooldown = 22000 + random number (12000)
		end
		if transition comment cooldown <= 0
			transition comment cooldown = 22000 + random number (12000)
		end
	elsif enhanced mode <> 0 && ambient story cooldown <= 0
		start ambient story
	elsif enhanced mode <> 0 && scenery comment cooldown <= 0
		say scenery dialogue
		scenery comment cooldown = 70000 + random number (40000)
		if director comment cooldown <= 0
			director comment cooldown = 22000 + random number (12000)
		end
		if transition comment cooldown <= 0
			transition comment cooldown = 22000 + random number (12000)
		end
	elsif enhanced mode <> 0 && director comment cooldown <= 0
		say director dialogue
		director comment cooldown = 120000 + random number (60000)
		if scenery comment cooldown <= 0
			scenery comment cooldown = 22000 + random number (12000)
		end
		if transition comment cooldown <= 0
			transition comment cooldown = 22000 + random number (12000)
		end
	elsif enhanced mode <> 0 && transition comment cooldown <= 0
		say transition dialogue
		transition comment cooldown = 105000 + random number (60000)
	elsif enhanced mode <> 0 && yeti distraction cooldown <= 0
		start yeti distraction
	end
end

func say enemy dialogue (enemy type: int)
	if enhanced mode == 0
		return
	end
	// Humanoid kills speak less often; the unusual farm enemies get the
	// occasional sharper punchline without turning every wave into chatter.
	if enemy type < 3 && random number (3) <> 0
		return
	end
	if enemy type < 3 && random number (5) == 0
		if random number (2) == 0
			say dialogue (123)
		else
			say dialogue (124)
		end
		return
	end
	if enemy type >= 3 && enemy type <= 9 && random number (5) == 0
		say dialogue (178 + random number (6))
		return
	end
	if enemy type == 0
		say dialogue trio (1, 2, 59)
	elsif enemy type == 1
		say dialogue trio (3, 4, 60)
	elsif enemy type == 2
		say dialogue trio (5, 6, 61)
	elsif enemy type == 3
		if random number (5) == 0
			say dialogue (84)
		elsif random number (4) == 0
			say dialogue (57 + random number (2))
		else
			say dialogue trio (7, 8, 62)
		end
	elsif enemy type == 4
		say dialogue trio (9, 10, 63)
	elsif enemy type == 5
		if random number (4) == 0
			say dialogue (189)
		else
			say dialogue quad (11, 12, 13, 64)
		end
	elsif enemy type == 6
		if random number (5) == 0
			say dialogue (85)
		else
			say dialogue trio (14, 15, 65)
		end
	elsif enemy type == 7
		if random number (4) == 0
			say dialogue (55)
		else
			say dialogue trio (16, 17, 66)
		end
	elsif enemy type == 8
		if random number (5) == 0
			say dialogue (86)
		else
			say dialogue trio (18, 19, 67)
		end
	elsif enemy type == 9
		say dialogue quad (20, 21, 22, 68)
	elsif enemy type == 10
		if random number (4) == 0
			say dialogue (177)
		else
			say dialogue trio (23, 24, 69)
		end
	else
		say dialogue trio (23, 24, 69)
	end
end

func say pickup dialogue (pickup kind: int)
	def taunt = 0
	if random number (4) == 0
		taunt = random number (6)
		if taunt == pickup taunt last
			taunt = (taunt + 1) % 6
		end
		pickup taunt last = taunt
		say dialogue (145 + taunt)
		return
	end
	if pickup kind == pickup ammo
		say dialogue quad (43, 44, 135, 136)
	elsif pickup kind == pickup damage
		say dialogue quad (45, 46, 137, 138)
	elsif pickup kind == pickup health
		say dialogue quad (47, 48, 139, 140)
	elsif pickup kind == pickup speed
		say dialogue quad (49, 50, 141, 142)
	else
		say dialogue quad (51, 52, 143, 144)
	end
end

func say scenery dialogue
	def scene = random number (14)
	def night = (day time / 30000) % 2
	if night <> 0 && random number (2) == 0
		scene = 3
	elsif night == 0 && random number (2) == 0
		scene = 4
	end
	if scene == scenery comment last
		scene = (scene + 1) % 14
	end
	scenery comment last = scene
	say dialogue (151 + scene)
end

func say director dialogue
	def comment = random number (6)
	if comment == director comment last
		comment = (comment + 1) % 6
	end
	director comment last = comment
	say dialogue (163 + comment)
end

func say transition dialogue
	def comment = random number (8)
	if comment == transition comment last
		comment = (comment + 1) % 8
	end
	transition comment last = comment
	say dialogue (169 + comment)
end

func start yeti distraction
	if enhanced mode == 0 || dialogue enabled == 0 || dialogue time > 0 || yeti distraction active <> 0 ||
	   yeti distraction cooldown > 0
		return
	end
	yeti distraction active = 1
	yeti distraction step = 1
	yeti x = 40 + random number (560)
	yeti y = 280 + random number (45)
	dialogue id = 186
	dialogue time = 2800
	yeti distraction cooldown = 150000 + random number (90000)
end

func update farmer easter egg (elapsed: int)
	if enhanced mode == 0
		return
	end
	if farmer easter egg active <> 0
		farmer easter egg time -= elapsed
		if farmer easter egg time <= 0
			farmer easter egg active = 0
		end
	else
		farmer easter egg cooldown -= elapsed
		if farmer easter egg cooldown <= 0
			farmer easter egg active = 1
			farmer easter egg time = 2600 + random number (3200)
			farmer easter egg x = 550 + random number (55)
			farmer easter egg y = 316 + random number (6)
			farmer easter egg cooldown = 120000 + random number (120000)
		end
	end
end

func reset game
	def i = 0
	player x = 320
	player y = 400
	player direction = 1
	player frame = 0
	player frame time = 0
	player shoot time = 0
	player gun warm = 0
	player gun warm time = 0
	player gun overload time = 0
	player gun latched = 0
	player life = 20
	player score = 0
	player level = 1
	player next level = 500
	player speed = 100
	player damage = 10
	player shot delay = 90
	player life max = 20
	if enhanced mode == 0
		// These are the original player's values. The source has no ammo
		// counter; Classic therefore uses an unlimited warmed rifle.
		player shot delay = 80
		player ammo max = 0
		player ammo = 0
		player gun warm max = 16
	else
		player ammo max = 180
		player ammo = player ammo max
		player gun warm max = 0
	end
	player damage boost = 0
	player damage boost time = 0
	player speed boost time = 0
	player rapid time = 0
	player poison time = 0
	player poison tick time = 0
