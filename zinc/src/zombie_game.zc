	ambient story used = 0:d
	ambient story last = -1
	upgrade menu = 0
	upgrade selection = 0
	upgrade pending = 0
	upgrade mask = 0:d
	upgrade ranks = 0:d
	last keys = 0:d
	while i < max zombies
		zombie active[i] = 0
		zombie classic move x time[i] = 0
		zombie classic move y time[i] = 0
		++i
	end
	i = 0
	while i < max bullets
		bullet active[i] = 0
