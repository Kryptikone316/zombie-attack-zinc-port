	player damage boost time = 0
	player speed boost time = 0
	player rapid time = 0
	player poison time = 0
	player poison tick time = 0
	player cripple time = 0
	player game over = 0
	player moving = 0
	paused = 0
	time stop time = 0
	time stop cooldown = 0
	day time = 0
	spawn time = 0
	spawn interval = 2000
	pickup spawn time = 0
